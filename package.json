{
  "name": "@mochirii/reaper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14",
    "node": "22.23.2"
  },
  "scripts": {
    "audit:all": "bun run audit:policy && bun run audit:production && bun run audit:complete && bun run audit:deno",
    "audit:bun": "bun run audit:complete",
    "audit:complete": "node scripts/audit-dependencies.mjs --scope=complete",
    "audit:deno": "bun scripts/audit-deno-locks.ts",
    "audit:policy": "node scripts/audit-dependencies.mjs --check-policy",
    "audit:production": "node scripts/audit-dependencies.mjs --scope=production",
    "audit:runtime": "bun run audit:production",
    "build": "bun node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "check": "bun run check:artifact && bun run audit:all && bun run typecheck && bun run test && bun run build && bun run release:check && bun run edge:contracts && bun run edge:fmt && bun run edge:check && bun run edge:test",
    "check:artifact": "node scripts/check-container-contract.mjs && bun run check:deployment && bun run check:publication",
    "check:deployment": "node scripts/check-gateway-deployment.mjs",
    "check:publication": "bun scripts/check-gateway-image.ts",
    "check:container": "node scripts/check-built-container.mjs",
    "contracts:check": "bun run edge:contracts",
    "dev": "bun src/index.ts",
    "edge:check": "bun scripts/run-edge-checks.ts",
    "edge:contracts": "bun scripts/check-edge-contracts.ts",
    "edge:fmt": "deno fmt --check supabase scripts/check-edge-contracts.ts scripts/check-website-source-compatibility.ts scripts/run-edge-checks.ts",
    "edge:reseal": "bun scripts/reseal-edge-source-closure.ts",
    "edge:test": "deno test --allow-env --node-modules-dir=auto --config=supabase/functions/reaper-discord-interactions/deno.json --lock=supabase/functions/reaper-discord-interactions/deno.lock --frozen=true supabase/functions/_shared/edge-tests.ts",
    "health:check": "bun scripts/check-runtime-health.ts",
    "register:guild": "bun src/register-commands.ts",
    "release:check": "bun scripts/check-release-readiness.ts",
    "start": "node dist/index.js",
    "test": "bun test tests",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "website:compat": "bun scripts/check-website-source-compatibility.ts"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.31",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@discordjs/rest": "2.6.3",
    "undici": "6.28.1"
  }
}

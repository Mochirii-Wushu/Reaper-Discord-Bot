{
  "name": "@mochirii/reaper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14",
    "node": "22.23.1"
  },
  "scripts": {
    "audit:production": "bun audit --production",
    "build": "bun node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "check": "bun run check:artifact && bun run typecheck && bun test tests && bun run build && bun run audit:production",
    "check:artifact": "node scripts/check-container-contract.mjs",
    "check:container": "node scripts/check-built-container.mjs",
    "dev": "bun src/index.ts",
    "register:guild": "bun src/register-commands.ts",
    "start": "node dist/index.js",
    "test": "bun test tests",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.31",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@discordjs/rest": "2.6.3",
    "undici": "6.28.0"
  }
}

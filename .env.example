DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=replace-with-guild-id
WELCOME_DM_ENABLED=true
REAPER_PENDING_VERIFICATION_SYNC_ENABLED=false
REAPER_PENDING_VERIFICATION_SYNC_URL=https://functions.example.test/functions/v1/reaper-discord-member-sync
REAPER_PENDING_VERIFICATION_SYNC_SECRET=
REAPER_PENDING_VERIFICATION_SYNC_TIMEOUT_MS=5000
REAPER_PENDING_VERIFICATION_SYNC_MAX_ATTEMPTS=2
# Required private persistent host directory when forwarding is enabled.
REAPER_MEMBER_SYNC_STATE_PATH=
# Optional host-owned absolute path for an atomic, mode-0600 readiness snapshot.
REAPER_HEALTH_STATE_PATH=
REAPER_HEALTH_HEARTBEAT_MS=30000
REAPER_HEALTH_MAX_AGE_MS=90000
REAPER_GALLERY_GATEWAY_ROLLBACK_ENABLED=false
DISCORD_GALLERY_CHANNEL_ID=replace-with-gallery-channel-id
DISCORD_GALLERY_ATTACHMENT_ORIGINS=https://discord-cdn.example.test
SUPABASE_FUNCTIONS_URL=https://functions.example.test/functions/v1
# The dormant Gateway rollback client and Reaper-owned Edge signer use the same
# bounded HMAC key-set contract. Real values belong only in runtime secrets.
DISCORD_GALLERY_INGEST_HMAC_KEYS_JSON=
DISCORD_GALLERY_INGEST_HMAC_ACTIVE_KEY_ID=
# Edge Function source-owner runtime configuration. Keep values synthetic here;
# inject every real value from the approved runtime secret/config boundary.
MOCHIRII_SITE_ORIGIN=https://www.example.test
MOCHIRII_CORS_ORIGINS=https://www.example.test
DISCORD_API_ORIGIN=https://discord-api.example.test
DISCORD_WEB_ORIGIN=https://discord-web.example.test
SUPABASE_URL=https://supabase.example.test
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEYS=
DISCORD_PUBLIC_KEY=
DISCORD_VOTE_CHANNEL_ID=replace-with-vote-channel-id
DISCORD_PHOTO_DAY_CHANNEL_ID=replace-with-photo-day-channel-id
DISCORD_SPOTLIGHT_POLL_CHANNEL_ID=replace-with-spotlight-channel-id
DISCORD_RAFFLE_CHANNEL_ID=replace-with-raffle-channel-id
DISCORD_REQUIRED_ROLE_IDS=replace-with-required-role-id-1,replace-with-required-role-id-2
DISCORD_MODERATOR_ROLE_IDS=replace-with-role-id
DISCORD_PENDING_BASE_ROLE_ID=replace-with-role-id
DISCORD_VERIFIED_ROLE_ID=replace-with-role-id
DISCORD_PENDING_ALLOWED_CHANNEL_IDS=replace-with-channel-id

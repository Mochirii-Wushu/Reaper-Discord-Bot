{
  "schemaVersion": 1,
  "contractId": "discord-gallery-authorization-context.v1",
  "status": "active-source-contract-not-deployed",
  "producerOwner": "Mochirii-Wushu/Reaper-Discord-Bot",
  "consumerOwner": "Mochirii-Wushu/Mochirii-Website",
  "consumerFunction": "submit-discord-gallery-image",
  "payloadFields": {
    "authorizationContextVersion": {
      "type": "string",
      "const": "discord-gallery-authorization-context.v1"
    },
    "authorizationContextSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "duplicateDecodedJsonKeys": "reject"
  },
  "canonicalization": {
    "encoding": "UTF-8",
    "rowFraming": "label + NUL + value + LF",
    "finalLf": true,
    "identifierValidation": {
      "inputType": "string",
      "trimOrCoercion": "reject",
      "asciiDecimalPattern": "^[1-9][0-9]{15,19}$",
      "minimumValue": "1",
      "maximumValue": "18446744073709551615",
      "canonicalRoundTrip": "BigInt(value).toString(10) === value",
      "validationOrder": [
        "require string without trimming or coercion",
        "require ASCII decimal syntax and 16..20 digits",
        "parse BigInt and require minimumValue <= value <= maximumValue",
        "require canonical base-10 BigInt round-trip equality"
      ]
    },
    "requiredRoleCount": 2,
    "requiredRoleUniqueness": "reject-duplicates-after-identifier-validation",
    "requiredRoleOrdering": "ascending-ASCII",
    "requiredRoleMatch": "all",
    "rowOrder": [
      "version",
      "guild",
      "gallery-channel",
      "required-role-count",
      "required-role-match",
      "required-role (repeated once per canonical required role)"
    ],
    "fixedVersion": "discord-gallery-authorization-context.v1"
  },
  "authorizationBoundary": {
    "producerInputs": [
      "configured Discord guild ID",
      "configured Discord gallery channel ID",
      "configured required Discord role IDs"
    ],
    "excludedInputs": [
      "secrets",
      "HMAC key IDs",
      "Discord member IDs"
    ],
    "producerBehavior": "hash canonical context and include both payload fields before HMAC signing",
    "consumerBehavior": "independently recompute from validated consumer runtime context and reject mismatch before profile lookup, external fetch, storage upload, or application-row mutation",
    "driftGuarantee": {
      "detects": "one-sided guild, gallery-channel, required-role-set, or role-match drift",
      "doesNotDetect": "coordinated matching configuration changes to both runtimes",
      "coordinatedChangeControl": "reviewed private activation manifest and provider readback"
    },
    "verificationOrder": [
      "bound raw request body and HMAC envelope",
      "verify exact-body HMAC v1 without mutation",
      "atomically consume the one-use nonce",
      "parse duplicate-key-safe JSON and validate exact authorization field shape",
      "recompute and compare authorization context from validated consumer runtime configuration",
      "require all configured roles during profile authorization",
      "permit external media fetch, storage upload, and application-row mutation"
    ],
    "nonceConsumptionException": "the nonce security ledger is the sole permitted pre-context mutation; nonce-store failure is fail-closed 503"
  },
  "hmacRelationship": {
    "contractId": "discord-gallery-ingest-hmac.v1",
    "wireChange": "none",
    "bodyBinding": "both authorization-context fields are inside the exact UTF-8 JSON body before HMAC signing"
  },
